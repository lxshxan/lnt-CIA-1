// Task 10: Using Promises

function saveTask(task) {
    return new Promise((resolve, reject) => {
        if (task.trim() !== "") {
            resolve(`Task "${task}" saved successfully.`);
        } else {
            reject("Task description cannot be empty.");
        }
    });
}

saveTask("Complete Node.js practical")
    .then((message) => {
        console.log(message);
    })
    .catch((error) => {
        console.error("Error:", error);
    });
