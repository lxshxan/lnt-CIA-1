// Task 2: Understanding Node.js Architecture

const fs = require("fs");

console.log("Starting file read...");

// Asynchronous file reading
fs.readFile("tasks.txt", "utf8", (err, data) => {
    if (err) {
        console.error("Error reading file:", err);
        return;
    }

    console.log("File contents:", data);
});

// This executes immediately without waiting for the file to be read.
console.log("File read operation started asynchronously.");
