// Task 5: Node Process Object, Command Line & Terminal I/O

const task = process.argv.slice(2).join(" ");

if (!task) {
    console.log("Please provide a task description.");
    process.exit(1);
}

console.log(`Task received: ${task}`);
console.log("Do you want to save this task? (y/n)");

process.stdin.setEncoding("utf8");

process.stdin.on("data", (input) => {
    const answer = input.trim().toLowerCase();

    if (answer === "y") {
        console.log(`Task "${task}" saved successfully.`);
    } else if (answer === "n") {
        console.log("Task was not saved.");
    } else {
        console.log("Please enter only y or n.");
    }

    process.exit();
});
