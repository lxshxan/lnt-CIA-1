// Task 9: Node.js Timers

console.log("Task Logger Started");

// setTimeout() executes only once after 2 seconds
setTimeout(() => {
    console.log("Reminder: Complete your task!");
}, 2000);

// setInterval() executes repeatedly every 1 second
let count = 1;

const timer = setInterval(() => {
    console.log(`Task check: ${count}`);

    count++;

    // Stop the interval after 3 checks
    if (count > 3) {
        clearInterval(timer);
        console.log("Task checking completed.");
    }
}, 1000);
